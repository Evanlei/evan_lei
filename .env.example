# Copy to .env.local for local development, and add the same values in Vercel → Project → Settings → Environment Variables.

# Spotify "now playing" bubble. Leave empty to hide it.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Optional: the public address, once you have a custom domain (used for share links and the sitemap).
NEXT_PUBLIC_SITE_URL=
